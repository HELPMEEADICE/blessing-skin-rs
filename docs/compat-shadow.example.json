{
  "format_version": 1,
  "requests": [
    {
      "name": "API root",
      "path": "/api/",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "OAuth user profile",
      "path": "/api/user",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_OAUTH_TOKEN}"
      }
    },
    {
      "name": "Yggdrasil player profile (replace with a fixture player)",
      "path": "/${BS_SHADOW_PLAYER}.json",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "Texture by hash",
      "path": "/textures/${BS_SHADOW_TEXTURE_HASH}",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Raw texture by legacy ID",
      "path": "/raw/${BS_SHADOW_TEXTURE_ID}",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Avatar by player",
      "path": "/avatar/player/${BS_SHADOW_PLAYER}?png&size=100",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Avatar by user",
      "path": "/avatar/user/${BS_SHADOW_USER_ID}?png&size=100",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Avatar by texture hash",
      "path": "/avatar/hash/${BS_SHADOW_TEXTURE_HASH}?png&size=100",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Skin preview by texture ID",
      "path": "/preview/${BS_SHADOW_TEXTURE_ID}?png&height=200",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Skin preview by texture hash",
      "path": "/preview/hash/${BS_SHADOW_TEXTURE_HASH}?png&height=200",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Default avatar",
      "path": "/avatar/0?png&size=100",
      "headers": {
        "Accept": "image/png"
      }
    }
  ]
}
