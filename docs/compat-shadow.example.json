{
  "format_version": 1,
  "requests": [
    {
      "name": "API root",
      "path": "/api/",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "OAuth user profile",
      "path": "/api/user",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_OAUTH_TOKEN}"
      }
    },
    {
      "name": "Yggdrasil player profile (replace with a fixture player)",
      "path": "/${BS_SHADOW_PLAYER}.json",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "CustomSkin player profile",
      "path": "/csl/${BS_SHADOW_PLAYER}.json",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "Texture by hash",
      "path": "/textures/${BS_SHADOW_TEXTURE_HASH}",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "CustomSkin texture by hash",
      "path": "/csl/textures/${BS_SHADOW_TEXTURE_HASH}",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "Raw texture by legacy ID",
      "path": "/raw/${BS_SHADOW_TEXTURE_ID}",
      "headers": {
        "Accept": "image/png"
      }
    },
    {
      "name": "OAuth player list",
      "path": "/api/players",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_OAUTH_TOKEN}"
      }
    },
    {
      "name": "OAuth closet list",
      "path": "/api/closet",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_OAUTH_TOKEN}"
      }
    },
    {
      "name": "OAuth notifications",
      "path": "/api/user/notifications",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_OAUTH_TOKEN}"
      }
    },
    {
      "name": "Admin user list",
      "path": "/api/admin/users",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_ADMIN_TOKEN}"
      }
    },
    {
      "name": "Admin player list",
      "path": "/api/admin/players",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_ADMIN_TOKEN}"
      }
    },
    {
      "name": "Admin report list",
      "path": "/api/admin/reports",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_ADMIN_TOKEN}"
      }
    },
    {
      "name": "Admin target user closet",
      "path": "/api/admin/closet/${BS_SHADOW_USER_ID}",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer ${BS_SHADOW_ADMIN_TOKEN}"
      }
    },
    {
      "name": "Skin library page",
      "path": "/skinlib",
      "headers": {
        "Accept": "text/html"
      }
    },
    {
      "name": "Skin library list",
      "path": "/skinlib/list?page=1",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "Skin metadata page data",
      "path": "/skinlib/info/${BS_SHADOW_TEXTURE_ID}",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "Texture metadata",
      "path": "/texture/${BS_SHADOW_TEXTURE_ID}",
      "headers": {
        "Accept": "application/json"
      }
    }
  ]
}
