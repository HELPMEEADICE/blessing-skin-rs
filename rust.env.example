# Copy to .env and replace credentials and paths for your installation.
BS_LISTEN=127.0.0.1:3000
APP_URL=https://skin.example.com
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
PUBLIC_PATH=public

# Keep the old site's prefix and use its existing database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessingskin
DB_USERNAME=blessingskin
DB_PASSWORD=replace-this-secret
# Optional: preserve Laravel DATABASE_URL deployments; when set, this takes precedence over DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, and DB_PASSWORD.
# DATABASE_URL=mysql://blessingskin:replace-this-secret@127.0.0.1:3306/blessingskin
# Optional: use the legacy MySQL/MariaDB Unix socket instead of TCP.
# DB_SOCKET=/run/mysqld/mysqld.sock
# Optional MySQL/MariaDB CA certificate path; overrides DATABASE_URL ssl-ca when both are set.
# MYSQL_ATTR_SSL_CA=/etc/mysql/ca.pem
DB_PREFIX=

# Point these at the existing Blessing Skin storage and texture directories.
STORAGE_PATH=/var/lib/blessing-skin-server/storage
TEXTURES_DIR=/var/lib/blessing-skin-server/storage/textures
PLUGINS_DIR=/var/lib/blessing-skin-server/storage/plugins
# Optional: enable the admin Rust/WASM plugin market with a trusted v1 JSON manifest.
# WASM_PLUGIN_REGISTRY_URL=https://plugins.example.com/registry-v1.json

# Optional; defaults to this repository's latest GitHub release API. Set empty to disable.
# RUST_RELEASES_API_URL=https://api.github.com/repos/HELPMEEADICE/blessing-skin-rs/releases/latest

# Preserve the old site's settings for password and OAuth compatibility.
PWD_METHOD=BCRYPT
SALT=
BCRYPT_ROUNDS=10
APP_KEY=replace-with-a-long-random-secret
PASSPORT_PUBLIC_KEY=file:///var/lib/blessing-skin-server/storage/oauth-public.key
PASSPORT_PRIVATE_KEY=file:///var/lib/blessing-skin-server/storage/oauth-private.key

MAIL_MAILER=smtp
# Optional provider credentials when MAIL_MAILER=mailgun or postmark.
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
# POSTMARK_TOKEN=
# POSTMARK_MESSAGE_STREAM_ID=outbound
# AWS credentials when MAIL_MAILER=ses or ses-v2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Optional. URL values override the matching split MAIL_* settings.
# MAIL_URL=smtp://user:percent-encoded-password@mail.example.com:587
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Blessing Skin

# SQLite alternative. Set DB_DATABASE to the existing SQLite file path.
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/lib/blessing-skin-server/storage/database.sqlite
